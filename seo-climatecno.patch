diff --git a/src/app/robots.ts b/src/app/robots.ts
new file mode 100644
index 0000000..3edb379
--- /dev/null
+++ b/src/app/robots.ts
@@ -0,0 +1,24 @@
+import type { MetadataRoute } from "next";
+
+const siteUrl = "https://www.climatecno.com.ar";
+
+export default function robots(): MetadataRoute.Robots {
+  return {
+    rules: {
+      userAgent: "*",
+      allow: "/",
+      disallow: [
+        "/ingresar",
+        "/registro",
+        "/cuenta",
+        "/usuarios",
+        "/presupuesto",
+        "/presupuestos",
+        "/tablas-tecnicas",
+        "/auth/",
+      ],
+    },
+    sitemap: `${siteUrl}/sitemap.xml`,
+    host: siteUrl,
+  };
+}
diff --git a/src/app/sitemap.ts b/src/app/sitemap.ts
new file mode 100644
index 0000000..35fc1e8
--- /dev/null
+++ b/src/app/sitemap.ts
@@ -0,0 +1,15 @@
+import type { MetadataRoute } from "next";
+
+const siteUrl = "https://www.climatecno.com.ar";
+
+// Solo la home es pública. Las demás rutas (login, cuenta, presupuestos,
+// usuarios, tablas técnicas) requieren sesión y no deben indexarse.
+export default function sitemap(): MetadataRoute.Sitemap {
+  return [
+    {
+      url: siteUrl,
+      changeFrequency: "monthly",
+      priority: 1,
+    },
+  ];
+}
